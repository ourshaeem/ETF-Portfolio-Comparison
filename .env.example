# Copy to .env and fill in. Never commit .env.

# Free key: https://www.alphavantage.co/support/#api-key  (25 requests/day on free tier)
ALPHA_VANTAGE_API_KEY=

# Optional — enables the AI analyst (https://console.anthropic.com). Without it the
# app falls back to a rule-based summary.
ANTHROPIC_API_KEY=

# Postgres (defaults match docker-compose.yml)
POSTGRES_USER=etf
POSTGRES_PASSWORD=etf
POSTGRES_DB=etf
TABLEAU_DB_PASSWORD=tableau

# Pipeline tuning (all optional)
EXTRA_SYMBOLS=DIA,IWM,VTI
HISTORY_START=1999-03-10
# 0 = full history
CALIBRATION_YEARS=0
MC_PATHS=10000
QUOTE_POLL_SECONDS=15
